rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUserDoc() {
      return get(userPath(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && currentUserDoc().data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isLecturer() {
      return hasRole('lecturer');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isDriver() {
      return hasRole('driver');
    }

    function isStaff() {
      return hasRole('staff');
    }

    function attendanceSessionPath(sessionId) {
      return /databases/$(database)/documents/attendanceSessions/$(sessionId);
    }

    function attendanceSession(sessionId) {
      return get(attendanceSessionPath(sessionId));
    }

    function busPath(busId) {
      return /databases/$(database)/documents/buses/$(busId);
    }

    function bus(busId) {
      return get(busPath(busId));
    }

    function validUserRole(role) {
      return role in ['student', 'lecturer', 'driver', 'staff'];
    }

    function userCreateKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'name',
        'email',
        'role',
        'matricNumber',
        'staffId',
        'emailVerified',
        'createdAt',
        'updatedAt'
      ]);
    }

    function userCreateValuesAreSafe(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validUserRole(request.resource.data.role)
        && request.resource.data.emailVerified == request.auth.token.email_verified;
    }

    function ownerProfileUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly([
          'name',
          'matricNumber',
          'staffId',
          'emailVerified',
          'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          !changed.hasAny(['emailVerified'])
          || request.resource.data.emailVerified == request.auth.token.email_verified
        );
    }

    function ownsAttendanceSession(sessionId) {
      return signedIn()
        && exists(attendanceSessionPath(sessionId))
        && attendanceSession(sessionId).data.lecturerId == request.auth.uid;
    }

    function ownsCurrentAttendanceSession() {
      return isLecturer()
        && resource.data.lecturerId == request.auth.uid;
    }

    function attendanceSessionKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'sessionId',
        'lecturerId',
        'courseCode',
        'requiresLocation',
        'latitude',
        'longitude',
        'geofenceRadius',
        'qrCodeValue',
        'startTime',
        'expiryTime',
        'status',
        'createdAt'
      ]);
    }

    function attendanceSessionValuesAreSafe(sessionId) {
      return request.resource.data.sessionId == sessionId
        && request.resource.data.lecturerId is string
        && request.resource.data.courseCode is string
        && request.resource.data.requiresLocation is bool
        && (
          (
            request.resource.data.requiresLocation == true
            && request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
            && request.resource.data.geofenceRadius is number
            && request.resource.data.geofenceRadius > 0
          )
          || (
            request.resource.data.requiresLocation == false
            && request.resource.data.latitude == null
            && request.resource.data.longitude == null
            && request.resource.data.geofenceRadius == null
          )
        )
        && request.resource.data.qrCodeValue is string
        && request.resource.data.startTime is timestamp
        && (
          request.resource.data.expiryTime == null
          || (
            request.resource.data.expiryTime is timestamp
            && request.resource.data.expiryTime > request.resource.data.startTime
          )
        )
        && request.resource.data.status in ['active', 'closed']
        && request.resource.data.createdAt is timestamp;
    }

    function attendanceSessionCreateIsSafe(sessionId) {
      return attendanceSessionKeysAreSafe()
        && attendanceSessionValuesAreSafe(sessionId)
        && (
          isAdmin()
          || (isLecturer() && request.resource.data.lecturerId == request.auth.uid)
        );
    }

    function attendanceSessionUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly(['status'])
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.lecturerId == resource.data.lecturerId
        && request.resource.data.qrCodeValue == resource.data.qrCodeValue
        && request.resource.data.status in ['active', 'closed'];
    }

    function activeSessionReadableByStudent() {
      return isStudent()
        && resource.data.status == 'active'
        && (
          resource.data.expiryTime == null
          || resource.data.expiryTime > request.time
        );
    }

    function attendanceRecordKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'recordId',
        'sessionId',
        'courseCode',
        'studentId',
        'studentName',
        'studentEmail',
        'scannedAt',
        'locationValidated',
        'latitude',
        'longitude',
        'distanceMeters',
        'status',
        'remarks'
      ]);
    }

    function attendanceRecordCreateIsSafe(recordId) {
      let session = attendanceSession(request.resource.data.sessionId);
      return attendanceRecordKeysAreSafe()
        && request.resource.data.recordId == recordId
        && recordId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.courseCode is string
        && request.resource.data.courseCode == session.data.courseCode
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.scannedAt is timestamp
        && request.resource.data.locationValidated is bool
        && (
          (
            session.data.requiresLocation != false
            && request.resource.data.locationValidated == true
            && request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
            && request.resource.data.distanceMeters is number
            && request.resource.data.distanceMeters >= 0
            && request.resource.data.distanceMeters <= session.data.geofenceRadius
          )
          || (
            session.data.requiresLocation == false
            && request.resource.data.locationValidated == false
            && request.resource.data.latitude == null
            && request.resource.data.longitude == null
            && request.resource.data.distanceMeters == null
          )
        )
        && request.resource.data.status == 'present'
        && request.resource.data.remarks is string
        && exists(attendanceSessionPath(request.resource.data.sessionId))
        && session.data.status == 'active'
        && (
          session.data.expiryTime == null
          || session.data.expiryTime > request.time
        );
    }

    function attendanceHistoryCreateIsSafe(uid, recordId) {
      return uid == request.auth.uid
        && attendanceRecordCreateIsSafe(recordId);
    }

    function facilityBookingCreateIsSafe(uid, bookingId) {
      return uid == request.auth.uid
        && bookingCreateIsSafe(bookingId);
    }

    function userBookingCopyMatchesOwner(uid) {
      return resource.data.studentId == uid
        && request.resource.data.studentId == uid
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.slotOccurrenceId == resource.data.slotOccurrenceId
        && request.resource.data.facilityId == resource.data.facilityId
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.facilityName == resource.data.facilityName
        && request.resource.data.studentName == resource.data.studentName
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.requestedDate == resource.data.requestedDate
        && request.resource.data.startTime == resource.data.startTime
        && request.resource.data.endTime == resource.data.endTime
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function facilityKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'facilityId',
        'name',
        'type',
        'location',
        'capacity',
        'status',
        'createdAt',
        'updatedAt'
      ]);
    }

    function facilityValuesAreSafe(facilityId) {
      return facilityKeysAreSafe()
        && request.resource.data.facilityId == facilityId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.status in ['available', 'unavailable']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function bookingKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'bookingId',
        'slotOccurrenceId',
        'facilityId',
        'templateId',
        'facilityName',
        'studentId',
        'studentName',
        'studentEmail',
        'requestedDate',
        'startTime',
        'endTime',
        'status',
        'reviewedBy',
        'reviewedAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    function facilityPath(facilityId) {
      return /databases/$(database)/documents/facilities/$(facilityId);
    }

    function userFacilityBookingPath(uid, bookingId) {
      return /databases/$(database)/documents/users/$(uid)/facilityBookings/$(bookingId);
    }

    function slotTemplatePath(facilityId, templateId) {
      return /databases/$(database)/documents/facilities/$(facilityId)/slotTemplates/$(templateId);
    }

    function bookingCreateIsSafe(bookingId) {
      return bookingKeysAreSafe()
        && request.resource.data.bookingId == bookingId
        && request.resource.data.slotOccurrenceId is string
        && request.resource.data.facilityId is string
        && exists(facilityPath(request.resource.data.facilityId))
        && get(facilityPath(request.resource.data.facilityId)).data.status == 'available'
        && request.resource.data.templateId is string
        && exists(slotTemplatePath(
          request.resource.data.facilityId,
          request.resource.data.templateId
        ))
        && get(slotTemplatePath(
          request.resource.data.facilityId,
          request.resource.data.templateId
        )).data.status == 'active'
        && request.resource.data.facilityName is string
        && request.resource.data.facilityName.size() > 0
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.bookingId ==
          request.auth.uid + '_' + request.resource.data.slotOccurrenceId
        && request.resource.data.studentName is string
        && request.resource.data.studentEmail is string
        && request.resource.data.requestedDate is timestamp
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function studentBookingCancelIsSafe() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly(['status', 'updatedAt'])
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.slotOccurrenceId == resource.data.slotOccurrenceId
        && request.resource.data.facilityId == resource.data.facilityId
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.facilityName == resource.data.facilityName
        && request.resource.data.studentName == resource.data.studentName
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.requestedDate == resource.data.requestedDate
        && request.resource.data.startTime == resource.data.startTime
        && request.resource.data.endTime == resource.data.endTime
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reviewedBy == resource.data.reviewedBy
        && request.resource.data.reviewedAt == resource.data.reviewedAt
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt is timestamp;
    }

    function staffBookingReviewIsSafe() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly(['status', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.slotOccurrenceId == resource.data.slotOccurrenceId
        && request.resource.data.facilityId == resource.data.facilityId
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.facilityName == resource.data.facilityName
        && request.resource.data.studentName == resource.data.studentName
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.requestedDate == resource.data.requestedDate
        && request.resource.data.startTime == resource.data.startTime
        && request.resource.data.endTime == resource.data.endTime
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'cancelled']
          )
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'cancelled'
          )
        );
    }

    function notificationKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'notificationId',
        'userId',
        'title',
        'message',
        'type',
        'bookingId',
        'facilityId',
        'facilityName',
        'status',
        'isRead',
        'createdAt'
      ]);
    }

    function notificationValuesAreSafe(notificationId) {
      return notificationKeysAreSafe()
        && request.resource.data.notificationId == notificationId
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.type == 'facilityBookingStatus'
        && request.resource.data.bookingId is string
        && request.resource.data.facilityId is string
        && request.resource.data.facilityName is string
        && request.resource.data.facilityName.size() > 0
        && request.resource.data.status in ['approved', 'cancelled']
        && request.resource.data.isRead == false
        && request.resource.data.createdAt is timestamp;
    }

    function staffNotificationCreateIsSafe(notificationId) {
      let bookingAfter = getAfter(userFacilityBookingPath(
        request.resource.data.userId,
        request.resource.data.bookingId
      ));
      return isStaff()
        && notificationValuesAreSafe(notificationId)
        && bookingAfter.data.status == request.resource.data.status
        && bookingAfter.data.studentId == request.resource.data.userId
        && bookingAfter.data.bookingId == request.resource.data.bookingId
        && bookingAfter.data.facilityId == request.resource.data.facilityId
        && bookingAfter.data.facilityName == request.resource.data.facilityName;
    }

    function slotTemplateKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'templateId',
        'facilityId',
        'slotMode',
        'slotDate',
        'weekday',
        'startMinutes',
        'endMinutes',
        'status',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]);
    }

    function slotTemplateModeIsSafe() {
      return (
          request.resource.data.slotMode == 'date'
          && request.resource.data.keys().hasAll(['slotDate'])
          && !request.resource.data.keys().hasAny(['weekday'])
          && request.resource.data.slotDate is timestamp
        )
        || (
          request.resource.data.slotMode == 'daily'
          && !request.resource.data.keys().hasAny(['slotDate', 'weekday'])
        )
        || (
          request.resource.data.slotMode == 'weekdays'
          && !request.resource.data.keys().hasAny(['slotDate', 'weekday'])
        )
        || (
          request.resource.data.slotMode == 'weekly'
          && request.resource.data.keys().hasAll(['weekday'])
          && !request.resource.data.keys().hasAny(['slotDate'])
          && request.resource.data.weekday is int
          && request.resource.data.weekday >= 1
          && request.resource.data.weekday <= 7
        );
    }

    function slotTemplateValuesAreSafe(facilityId, templateId) {
      return slotTemplateKeysAreSafe()
        && request.resource.data.templateId == templateId
        && request.resource.data.facilityId == facilityId
        && request.resource.data.slotMode in ['date', 'daily', 'weekdays', 'weekly']
        && slotTemplateModeIsSafe()
        && request.resource.data.startMinutes is int
        && request.resource.data.startMinutes >= 0
        && request.resource.data.startMinutes < 1440
        && request.resource.data.endMinutes is int
        && request.resource.data.endMinutes > request.resource.data.startMinutes
        && request.resource.data.endMinutes <= 1440
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdBy is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function reservationKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'slotOccurrenceId',
        'facilityId',
        'templateId',
        'bookingId',
        'studentId',
        'requestedDate',
        'startTime',
        'endTime',
        'status',
        'createdAt',
        'updatedAt'
      ]);
    }

    function reservationCreateIsSafe(slotOccurrenceId) {
      return reservationKeysAreSafe()
        && request.resource.data.bookingId == slotOccurrenceId
        && request.resource.data.bookingId ==
          request.auth.uid + '_' + request.resource.data.slotOccurrenceId
        && request.resource.data.slotOccurrenceId is string
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.facilityId is string
        && request.resource.data.templateId is string
        && exists(slotTemplatePath(
          request.resource.data.facilityId,
          request.resource.data.templateId
        ))
        && request.resource.data.requestedDate is timestamp
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function staffReservationApproveIsSafe() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly(['status', 'updatedAt'])
        && request.resource.data.slotOccurrenceId == resource.data.slotOccurrenceId
        && request.resource.data.facilityId == resource.data.facilityId
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.requestedDate == resource.data.requestedDate
        && request.resource.data.startTime == resource.data.startTime
        && request.resource.data.endTime == resource.data.endTime
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && request.resource.data.updatedAt is timestamp;
    }

    function studentReservationDeleteIsSafe() {
      return resource.data.studentId == request.auth.uid
        && resource.data.status == 'pending';
    }

    function slotCapacityKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'slotOccurrenceId',
        'facilityId',
        'requestedDate',
        'startTime',
        'endTime',
        'pendingCount',
        'approvedCount',
        'activeCount',
        'createdAt',
        'updatedAt'
      ]);
    }

    function slotCapacityValuesAreSafe(slotOccurrenceId) {
      return slotCapacityKeysAreSafe()
        && request.resource.data.slotOccurrenceId == slotOccurrenceId
        && request.resource.data.facilityId is string
        && request.resource.data.requestedDate is timestamp
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.pendingCount is int
        && request.resource.data.pendingCount >= 0
        && request.resource.data.approvedCount is int
        && request.resource.data.approvedCount >= 0
        && request.resource.data.activeCount is int
        && request.resource.data.activeCount >= 0
        && request.resource.data.activeCount ==
          request.resource.data.pendingCount + request.resource.data.approvedCount
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && exists(facilityPath(request.resource.data.facilityId));
    }

    function busKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'busId',
        'routeName',
        'driverIds',
        'status',
        'startName',
        'endName',
        'routePoints'
      ]);
    }

    function routePointIsSafe(point) {
      return point is map
        && point.keys().hasOnly(['latitude', 'longitude'])
        && point.latitude is number
        && point.latitude >= -90
        && point.latitude <= 90
        && point.longitude is number
        && point.longitude >= -180
        && point.longitude <= 180;
    }

    function busDriverIdAtIsSafe(index) {
      return request.resource.data.driverIds.size() <= index
        || (
          request.resource.data.driverIds[index] is string
          && request.resource.data.driverIds[index].size() > 0
        );
    }

    function busDriverIdsAreSafe() {
      return request.resource.data.driverIds is list
        && request.resource.data.driverIds.size() <= 10
        && busDriverIdAtIsSafe(0)
        && busDriverIdAtIsSafe(1)
        && busDriverIdAtIsSafe(2)
        && busDriverIdAtIsSafe(3)
        && busDriverIdAtIsSafe(4)
        && busDriverIdAtIsSafe(5)
        && busDriverIdAtIsSafe(6)
        && busDriverIdAtIsSafe(7)
        && busDriverIdAtIsSafe(8)
        && busDriverIdAtIsSafe(9);
    }

    function routePointAtIsSafe(index) {
      return request.resource.data.routePoints.size() <= index
        || routePointIsSafe(request.resource.data.routePoints[index]);
    }

    function busRoutePointsAreSafe() {
      return request.resource.data.routePoints is list
        && request.resource.data.routePoints.size() >= 2
        && request.resource.data.routePoints.size() <= 30
        && routePointAtIsSafe(0)
        && routePointAtIsSafe(1)
        && routePointAtIsSafe(request.resource.data.routePoints.size() - 1);
    }

    function busValuesAreSafe(busId) {
      return busKeysAreSafe()
        && request.resource.data.busId == busId
        && request.resource.data.routeName is string
        && request.resource.data.routeName.size() > 0
        && busDriverIdsAreSafe()
        && request.resource.data.status in ['active', 'inactive']
        && (
          request.resource.data.startName == null
          || request.resource.data.startName is string
        )
        && (
          request.resource.data.endName == null
          || request.resource.data.endName is string
        )
        && busRoutePointsAreSafe();
    }

    function busLocationKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'busId',
        'driverId',
        'latitude',
        'longitude',
        'speed',
        'heading',
        'isBroadcasting',
        'updatedAt'
      ]);
    }

    function busLocationValuesAreSafe(busId) {
      return busLocationKeysAreSafe()
        && request.resource.data.busId == busId
        && request.resource.data.driverId is string
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.speed is number
        && request.resource.data.speed >= 0
        && request.resource.data.heading is number
        && request.resource.data.heading >= 0
        && request.resource.data.heading <= 360
        && request.resource.data.isBroadcasting is bool
        && request.resource.data.updatedAt is timestamp;
    }

    function driverCanBroadcastBus(busId) {
      return isDriver()
        && exists(busPath(busId))
        && (
          (
            bus(busId).data.driverIds is list
            && bus(busId).data.driverIds.hasAny([request.auth.uid])
          )
          || (
            bus(busId).data.driverId is string
            && bus(busId).data.driverId == request.auth.uid
          )
        )
        && bus(busId).data.status == 'active'
        && request.resource.data.driverId == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && userCreateKeysAreSafe()
        && userCreateValuesAreSafe(uid);
      allow update: if isAdmin() || (isOwner(uid) && ownerProfileUpdateIsSafe());
      allow delete: if isAdmin();

      match /attendanceHistory/{recordId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create: if isStudent()
          && attendanceHistoryCreateIsSafe(uid, recordId);
        allow update, delete: if isAdmin();
      }

      match /facilityBookings/{bookingId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create: if isStudent()
          && facilityBookingCreateIsSafe(uid, bookingId);
        allow update: if isAdmin()
          || (
            isStudent()
            && isOwner(uid)
            && userBookingCopyMatchesOwner(uid)
            && studentBookingCancelIsSafe()
          )
          || (
            isStaff()
            && userBookingCopyMatchesOwner(uid)
            && staffBookingReviewIsSafe()
          );
        allow delete: if isAdmin();
      }

      match /lecturerAttendance/{sessionId}/records/{recordId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create: if isStudent()
          && uid == attendanceSession(sessionId).data.lecturerId
          && request.resource.data.sessionId == sessionId
          && attendanceRecordCreateIsSafe(recordId);
        allow update, delete: if isAdmin();
      }
    }

    match /attendanceSessions/{sessionId} {
      allow get, list: if isAdmin()
        || ownsCurrentAttendanceSession()
        || activeSessionReadableByStudent();
      allow create: if attendanceSessionCreateIsSafe(sessionId);
      allow update: if isAdmin()
        || (
          isLecturer()
          && resource.data.lecturerId == request.auth.uid
          && attendanceSessionUpdateIsSafe()
        );
      allow delete: if isAdmin();

      match /records/{recordId} {
        allow get, list: if isAdmin() || ownsAttendanceSession(sessionId);
        allow create: if isStudent()
          && request.resource.data.sessionId == sessionId
          && attendanceRecordCreateIsSafe(recordId);
        allow update, delete: if isAdmin();
      }
    }

    match /attendanceRecords/{recordId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || ownsAttendanceSession(resource.data.sessionId);
      allow list: if isAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isLecturer() && ownsAttendanceSession(resource.data.sessionId));
      allow create: if isStudent()
        && attendanceRecordCreateIsSafe(recordId);
      allow update, delete: if isAdmin();
    }

    match /facilities/{facilityId} {
      allow get, list: if isAdmin()
        || isStaff()
        || (signedIn() && resource.data.status == 'available');
      allow create, update: if isAdmin() && facilityValuesAreSafe(facilityId);
      allow delete: if isAdmin();

      match /slotTemplates/{templateId} {
        allow get, list: if isAdmin()
          || isStaff()
          || (signedIn() && resource.data.status == 'active');
        allow create: if isStaff()
          && slotTemplateValuesAreSafe(facilityId, templateId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isStaff()
          && slotTemplateValuesAreSafe(facilityId, templateId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isStaff() || isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow get: if isAdmin()
        || isStaff()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || (
          isStudent()
          && !exists(/databases/$(database)/documents/bookings/$(bookingId))
        );
      allow list: if isAdmin()
        || isStaff()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && bookingCreateIsSafe(bookingId);
      allow update: if isAdmin()
        || (isStudent() && studentBookingCancelIsSafe())
        || (isStaff() && staffBookingReviewIsSafe());
      allow delete: if isAdmin();
    }

    match /facilitySlotReservations/{slotOccurrenceId} {
      allow get, list: if signedIn();
      allow create: if isStudent()
        && reservationCreateIsSafe(slotOccurrenceId);
      allow update: if isAdmin()
        || (isStaff() && staffReservationApproveIsSafe());
      allow delete: if isAdmin()
        || (isStudent() && studentReservationDeleteIsSafe())
        || isStaff();
    }

    match /facilitySlotCapacity/{slotOccurrenceId} {
      allow get, list: if signedIn();
      allow create, update: if (isStudent() || isStaff() || isAdmin())
        && slotCapacityValuesAreSafe(slotOccurrenceId);
      allow delete: if isAdmin();
    }

    match /buses/{busId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && busValuesAreSafe(busId);
      allow delete: if isAdmin();
    }

    match /busLocations/{busId} {
      allow read: if signedIn();
      allow create, update: if busLocationValuesAreSafe(busId)
        && (
          isAdmin()
          || driverCanBroadcastBus(busId)
        );
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || staffNotificationCreateIsSafe(notificationId);
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

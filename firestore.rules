rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUserDoc() {
      return get(userPath(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && currentUserDoc().data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function validUserRole(role) {
      return role in ['student', 'lecturer', 'driver', 'staff'];
    }

    function userCreateKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'name',
        'email',
        'role',
        'matricNumber',
        'staffId',
        'emailVerified',
        'createdAt',
        'updatedAt'
      ]);
    }

    function userCreateValuesAreSafe(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validUserRole(request.resource.data.role)
        && request.resource.data.emailVerified == request.auth.token.email_verified;
    }

    function ownerProfileUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly([
          'name',
          'matricNumber',
          'staffId',
          'emailVerified',
          'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          !changed.hasAny(['emailVerified'])
          || request.resource.data.emailVerified == request.auth.token.email_verified
        );
    }

    function ownsAttendanceSession(sessionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/attendanceSessions/$(sessionId))
        && get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.lecturerId == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && userCreateKeysAreSafe()
        && userCreateValuesAreSafe(uid);
      allow update: if isAdmin() || (isOwner(uid) && ownerProfileUpdateIsSafe());
      allow delete: if isAdmin();
    }

    match /attendanceSessions/{sessionId} {
      allow read: if signedIn();
      allow create: if (hasRole('lecturer') || isAdmin())
        && request.resource.data.lecturerId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (
          hasRole('lecturer')
          && resource.data.lecturerId == request.auth.uid
          && request.resource.data.lecturerId == resource.data.lecturerId
        );
    }

    match /attendanceRecords/{recordId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || ownsAttendanceSession(resource.data.sessionId);
      allow list: if isAdmin() || hasRole('lecturer');
      allow create: if hasRole('student')
        && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /facilities/{facilityId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isAdmin()
        || hasRole('staff')
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow list: if isAdmin() || hasRole('staff');
      allow create: if hasRole('student')
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || hasRole('staff');
      allow delete: if isAdmin();
    }

    match /buses/{busId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /busLocations/{busId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        || (
          hasRole('driver')
          && request.resource.data.driverId == request.auth.uid
          && (!exists(/databases/$(database)/documents/busLocations/$(busId))
            || resource.data.driverId == request.auth.uid)
        );
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead'])
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
